# Values come from the outputs of the suppliagent-<env>-console CDK stack (no secrets here).
# aws cloudformation describe-stacks --stack-name suppliagent-dev-console --query "Stacks[0].Outputs" --region eu-west-1
VITE_USER_POOL_ID=eu-west-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/v1
# mock (default for local development) | api: real orders API (what scripts/deploy-console.sh builds)
VITE_ORDERS_SOURCE=mock
# Shown on the "Try the demo" page for judges (FN-31); public contact points, not secrets
VITE_DEMO_WHATSAPP=+393452460472
VITE_DEMO_ORDER_EMAIL=ordini@suppliagent.stonecutters.besharp.net
